{
  "version": 2,
  "functions": {
    "api/cron.js":      { "maxDuration": 30 },
    "api/audit.js":     { "maxDuration": 30 },
    "api/dashboard.js": { "maxDuration": 10 },
    "api/reset.js":     { "maxDuration": 10 },
    "api/test.js":      { "maxDuration": 10 }
  },
  "routes": [
    { "src": "/api/cron",      "dest": "/api/cron.js" },
    { "src": "/api/audit",     "dest": "/api/audit.js" },
    { "src": "/api/dashboard", "dest": "/api/dashboard.js" },
    { "src": "/api/reset",     "dest": "/api/reset.js" },
    { "src": "/api/state",     "dest": "/api/state.js" },
    { "src": "/api/logger",    "dest": "/api/logger.js" },
    { "src": "/api/test",      "dest": "/api/test.js" },
    { "src": "/(.*)",          "dest": "/public/index.html" }
  ]
}