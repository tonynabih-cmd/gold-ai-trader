# ─────────────────────────────────────────────────────────────────────────────
# GOLD AI TRADER — Required Environment Variables
# Copy this file to .env.local (development) or set via Vercel dashboard (prod).
# NEVER commit any file that contains real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Bot Control ───────────────────────────────────────────────────────────────
# Hard on/off switch.  Set to 'true' to allow trading.
BOT_ENABLED=true

# Live-mode safety latch.
# Set CAPITAL_ENV=live AND LIVE_TRADING_MODE=CONFIRMED_REAL_MONEY for real money.
# Leave CAPITAL_ENV=demo for paper trading.
CAPITAL_ENV=demo
LIVE_TRADING_MODE=

# ── Capital.com API ───────────────────────────────────────────────────────────
CAPITAL_API_KEY=
CAPITAL_EMAIL=
CAPITAL_PASSWORD=

# ── Cron endpoint security ────────────────────────────────────────────────────
# Must be at least 16 characters; use a random string of 32+ characters.
# Example: openssl rand -hex 32
CRON_SECRET=

# ── Upstash Redis (KV store for bot state and logs) ───────────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── Telegram alerts (optional) ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Anthropic (Claude daily audit) ───────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Risk configuration ────────────────────────────────────────────────────────
# Maximum allowed bid/ask spread in USD.  Trades are skipped if spread exceeds this.
MAX_SPREAD=0.40
